extends ../../layouts/default.pug
include ../../mixins/box-head.pug

block main
  .container.my-3
    .row
      .col-12
        .box-head Chat
    
    .row
      .col-12
        .chat
          .inner-body
            each chat in chats
                div(class=(chat.user_id == user.id? "inner-outgoing" : "inner-incoming"))
                    if (chat.user_id != user.id)
                        .inner-name #{chat.infoUser.fullName}
                    .inner-content
                        | #{chat.content}
            //- .inner-outgoing
            //-   .inner-content
            //-     | Thế à? Ok e iu
            //- .inner-incoming
            //-   .inner-name Em Yêu
            //-   .inner-content
            //-     | Nhanh nha nhanh nha
          .inner-foot
            form(
              class="inner-form"
              action=""
            )
              input(
                type="text"
                placeholder="Nhập nội dung..."
                name="content"
              )
              button(type="submit")
                i.fa-solid.fa-paper-plane